# Hermes Agent's ACP adapter. dsh delegates to it as a subagent over Agent Client Protocol on stdio.
# The build context is the HERMES CHECKOUT, not this repo:
#   docker build -f docker/Dockerfile.hermes-acp -t bubble-watch/hermes-acp ~/projects/hermes-agent
FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /hermes
ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH

COPY . /hermes
# Neither is a default Hermes dependency: agent-client-protocol is the optional `acp` extra its
# adapter imports lazily (without it hermes-acp exits 1 at ACP initialize), and arize-otel is what
# the observability/arize plugin needs to export spans.
RUN uv sync --frozen --no-dev \
    && uv pip install "agent-client-protocol==0.9.0" arize-otel

# The isolated analyst home is mounted here by the ACP row; bubble-watch wrote its config.
ENV HERMES_HOME=/work/.hermes-analyst \
    TIRITH_ENABLED=false
WORKDIR /work

# stdout is the ACP JSON-RPC transport; hermes-acp routes all logging to stderr.
ENTRYPOINT ["hermes-acp"]

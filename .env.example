# bubble-watch settings. Copy to .env and fill in; .env is gitignored. Never commit keys.
# Keep comments on their own lines: `KEY=   # comment` on an empty value is read as the comment.

# --- Required ---
# Grok 4.6 for the dsh orchestrator and the Hermes analyst it delegates to
XAI_API_KEY=

# --- Web search (recommended) ---
# Tavily: Hermes uses it natively; dsh via bubble-watch's dsh/plugins/web-search-tavily.mjs
TAVILY_API_KEY=

# --- Models (default grok-4.6); leave HERMES_ANALYST_MODEL empty to reuse the orchestrator's ---
# HERMES_ANALYST_MODEL=grok-4.6
# DSH_ANALYST_MODEL=grok-4.6

# --- Tracing (optional; no-op when unset) ---
# One run is one trace: the driver opens the root span and publishes its traceparent to both
# children (TRACEPARENT for the MCP server, HERMES_ARIZE_TRACEPARENT for Hermes' arize plugin).
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=bubble-watch
# ARIZE_COLLECTOR_ENDPOINT=https://otlp.arize.com/v1

# --- Optional data/tools ---
# Exa: web search fallback when TAVILY_API_KEY is unset
EXA_API_KEY=
# Historical option snapshots (EOD IV for past dates)
ALPHAVANTAGE_API_KEY=

# --- dsh runtime (defaults shown) ---
# DSH_BIN=./bin/dsh
# DSH_HOME=./.dsh
# DSH_REPO=~/projects/deepseek-harness
# DSH_NODE=~/.nvm/versions/node/v24.21.0/bin/node
# ANALYST_TIMEOUT_S=600      # per analyst call
# RUN_TIMEOUT_S=3600         # the whole run; must exceed ANALYST_TIMEOUT_S

# --- Hermes runtime (defaults shown) ---
# The analyst server drives the repo checkout's one-shot CLI; HERMES_ANALYST_HOME is the
# isolated home bubble-watch writes (web-only toolset), never the user's ~/.hermes.
# HERMES_BIN=./bin/hermes
# HERMES_REPO=~/projects/hermes-agent
# HERMES_ANALYST_HOME=./.hermes-analyst

# --- Containers mode (optional; default is local) ---
# dsh spawns each sibling runtime with `docker run -i`, so stdio and the protocols are unchanged.
# Build the images with docker/build.sh first, and set DSH_BIN=./bin/dsh-docker to containerise dsh.
# BUBBLE_WATCH_DEPLOY=containers
# BUBBLE_WATCH_HOST_ROOT=/abs/path/to/this/repo   # -v sources are host paths, always
# BUBBLE_WATCH_MCP_IMAGE=bubble-watch/mcp-tools
# BUBBLE_WATCH_HERMES_IMAGE=bubble-watch/hermes
# BUBBLE_WATCH_DSH_IMAGE=bubble-watch/dsh-runner
# BUBBLE_WATCH_DOCKER_SOCK=/var/run/docker.sock

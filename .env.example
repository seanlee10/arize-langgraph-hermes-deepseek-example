# bubble-watch settings. Copy to .env and fill in; .env is gitignored. Never commit keys.
# Keep comments on their own lines: `KEY=   # comment` on an empty value is read as the comment.

# --- Required ---
# Grok 4.6 for both analysts and the report writer
XAI_API_KEY=
# Any secret you choose; `bubble-watch hermes-gateway` uses it as the gateway's API_SERVER_KEY
HERMES_API_KEY=
HERMES_API_URL=http://localhost:8642/v1

# --- Models (default grok-4.6); leave HERMES_ANALYST_MODEL empty to use the gateway's model ---
# HERMES_ANALYST_MODEL=grok-4.6
# DSH_ANALYST_MODEL=grok-4.6
# WRITER_MODEL=grok-4.6

# --- Tracing (optional; no-op when unset) ---
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=bubble-watch
# ARIZE_COLLECTOR_ENDPOINT=https://otlp.arize.com/v1

# --- Optional data/tools ---
# Web search for both analysts via Exa (without it, dsh has no working web_search)
EXA_API_KEY=
# Historical option snapshots (EOD IV for past dates)
ALPHAVANTAGE_API_KEY=

# --- dsh runtime (defaults shown) ---
# DSH_BIN=./bin/dsh
# DSH_HOME=./.dsh
# DSH_REPO=~/projects/deepseek-harness
# DSH_NODE=~/.nvm/versions/node/v24.21.0/bin/node
# ANALYST_TIMEOUT_S=600

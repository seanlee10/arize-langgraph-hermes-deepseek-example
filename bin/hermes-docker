#!/bin/sh
# Hermes launcher for CONTAINERS mode: set HERMES_BIN to this and the tool server's `hermes chat`
# call runs in its own container instead of a local process. argv passes straight through.
#
# Mount sources are host paths: the daemon resolves -v for sibling containers wherever the CLI
# issuing it runs. The analyst home must be shared, because the query file is written there.
: "${BUBBLE_WATCH_HOST_ROOT:?set BUBBLE_WATCH_HOST_ROOT to the project root on the host}"
IMAGE="${BUBBLE_WATCH_HERMES_IMAGE:-bubble-watch/hermes}"

set -- run -i --rm \
  -e XAI_API_KEY -e TAVILY_API_KEY -e EXA_API_KEY -e TIRITH_ENABLED \
  -e HERMES_ARIZE_TRACEPARENT -e HERMES_ARIZE_SPACE_ID -e HERMES_ARIZE_API_KEY \
  -e HERMES_ARIZE_PROJECT_NAME -e HERMES_ARIZE_COLLECTOR_ENDPOINT \
  -e "HERMES_HOME=/work/.hermes-analyst" \
  -v "$BUBBLE_WATCH_HOST_ROOT/.hermes-analyst:/work/.hermes-analyst" \
  -w /work "$IMAGE" "$@"
exec docker "$@"

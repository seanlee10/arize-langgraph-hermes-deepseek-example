#!/bin/sh
# dsh launcher for CONTAINERS mode: set DSH_BIN to this and the Python SDK's stdio JSON-RPC talks to
# a container instead of a local process. argv is passed straight through, so the SDK's
# `--profile sdk --patch …` still applies — those paths must be the ones launch_paths() produced.
#
# The dsh container spawns its own siblings, so it needs the Docker socket. Mounts are host paths:
# the daemon resolves -v for sibling containers, wherever the CLI issuing it happens to run.
: "${BUBBLE_WATCH_HOST_ROOT:?set BUBBLE_WATCH_HOST_ROOT to the project root on the host}"
IMAGE="${BUBBLE_WATCH_DSH_IMAGE:-bubble-watch/dsh-runner}"
DOCKER_SOCK="${BUBBLE_WATCH_DOCKER_SOCK:-/var/run/docker.sock}"

# Forwarded by NAME: the value comes from this process's environment, which the driver set for
# this run. Nothing per-run is baked into the image or the composition.
set -- run -i --rm \
  -e XAI_API_KEY -e TAVILY_API_KEY -e EXA_API_KEY -e ALPHAVANTAGE_API_KEY \
  -e TRACEPARENT -e HERMES_ARIZE_TRACEPARENT -e BUBBLE_WATCH_SESSION_ID -e HERMES_REPO \
  -e ARIZE_SPACE_ID -e ARIZE_API_KEY -e ARIZE_PROJECT_NAME -e ARIZE_COLLECTOR_ENDPOINT \
  -e HERMES_ARIZE_SPACE_ID -e HERMES_ARIZE_API_KEY -e HERMES_ARIZE_PROJECT_NAME \
  -e HERMES_ARIZE_COLLECTOR_ENDPOINT \
  -e "BUBBLE_WATCH_HOST_ROOT=$BUBBLE_WATCH_HOST_ROOT" \
  -e "BUBBLE_WATCH_MCP_IMAGE=${BUBBLE_WATCH_MCP_IMAGE:-bubble-watch/mcp-tools}" \
  -e "BUBBLE_WATCH_HERMES_IMAGE=${BUBBLE_WATCH_HERMES_IMAGE:-bubble-watch/hermes}" \
  -e DSH_HOME=/work/.dsh \
  -v "$BUBBLE_WATCH_HOST_ROOT:/work" \
  -v "$DOCKER_SOCK:/var/run/docker.sock" \
  -w /work "$IMAGE" "$@"
exec docker "$@"
